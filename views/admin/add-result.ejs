<%- include('partials/head') %>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/choices.js/public/assets/styles/choices.min.css">
  <script src="https://cdn.jsdelivr.net/npm/choices.js/public/assets/scripts/choices.min.js"></script>

  <body>
    <div id="preloader">
      <div class="preloader-spinner"></div>
    </div>
    <div class="container-fluid p-0">
      <%- include('partials/header') %>
        <section class="d-flex">
          <%- include('partials/nav') %>
            <div class="content rms-content flex-grow-1">

              <!-- Page Header -->
              <div class="rms-page-header">
                <h3><i class="fa fa-file-text mr-2" style="color:var(--primary)"></i>Declare Result</h3>
                <ol class="breadcrumb mb-0">
                  <li class="breadcrumb-item">Home</li>
                  <li class="breadcrumb-item">Results</li>
                  <li class="breadcrumb-item active">Add Result</li>
                </ol>
              </div>

              <!-- Session & Term Selection -->
              <div class="card mb-4">
                <div class="card-body">
                  <div class="row">
                    <div class="col-md-6">
                      <div class="form-group mb-0">
                        <label><i class="fa fa-calendar mr-1"></i> Academic Session</label>
                        <select id="global_session" class="form-control">
                          <% sessions.forEach(s=> { %>
                            <option value="<%= s.name %>" <%=(typeof branding !=='undefined' &&
                              branding.currentSession===s.name) ? 'selected' : '' %>><%= s.name %>
                            </option>
                            <% }) %>
                        </select>
                      </div>
                    </div>
                    <div class="col-md-6">
                      <div class="form-group mb-0">
                        <label><i class="fa fa-clock-o mr-1"></i> Term</label>
                        <select id="global_term" class="form-control">
                          <option value="First" <%=(typeof branding !=='undefined' && branding.currentTerm==='First' )
                            ? 'selected' : '' %>>First Term</option>
                          <option value="Second" <%=(typeof branding !=='undefined' && branding.currentTerm==='Second' )
                            ? 'selected' : '' %>>Second Term</option>
                          <option value="Third" <%=(typeof branding !=='undefined' && branding.currentTerm==='Third' )
                            ? 'selected' : '' %>>Third Term</option>
                        </select>
                      </div>
                    </div>
                  </div>
                </div>
              </div>

              <!-- Bulk Upload Card -->
              <div class="card mb-4">
                <div class="card-header d-flex align-items-center justify-content-between">
                  <div class="d-flex align-items-center gap-2">
                    <i class="fa fa-upload mr-2" style="color:var(--primary)"></i>
                    <h5 class="m-0" style="font-size:14px;">Bulk Upload via Excel</h5>
                  </div>
                  <div class="d-flex align-items-center">
                    <div class="pr-3">
                      <select class="form-control mr-2" id="select_class" style="min-width:180px;">
                        <option value="">Select Class Template</option>
                        <% classes.forEach(element=> { %>
                          <option value="<%= element._id %>">
                            <%= element.cname %>
                          </option>
                          <% }) %>
                      </select>
                    </div>
                    <button id="download_template" class="btn btn-primary">
                      <i class="fa fa-download mr-1"></i> Download Template
                    </button>
                  </div>
                </div>
                <div class="card-body">
                  <div class="alert alert-success alert-dismissible fade show" role="alert" id="feedback">
                    <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                      <span aria-hidden="true">&times;</span>
                    </button>
                    <strong>File uploaded successfully</strong>
                  </div>
                  <form action="/admin/add-result" class="dropzone" id="upload-widget" enctype="multipart/form-data">
                  </form>
                </div>
              </div>

              <!-- Manual Entry Card -->
              <div class="card">
                <div class="card-header">
                  <h5 class="m-0" style="font-size:14px;"><i class="fa fa-pencil mr-2"
                      style="color:var(--primary)"></i>Declare a Result Manually</h5>
                </div>
                <div class="card-body">
                  <%- include('partials/flash') %>
                    <h4 id="err" style="display:none;font-size:14px;color:#ef4444;margin-bottom:12px;">Please fill in
                      all required fields.</h4>

                    <form action="" method="POST">
                      <div class="row">
                        <div class="col-md-6">
                          <div class="form-group">
                            <label for="sclass">Class</label>
                            <select name="sclass" id="sclass" class="form-control">
                              <option value="">Select class</option>
                              <% classes.forEach(element=> { %>
                                <option value="<%= element._id %>" class="rmd">
                                  <%= element.cname %>
                                </option>
                                <% }) %>
                            </select>
                          </div>
                        </div>
                        <div class="col-md-6">
                          <div class="form-group">
                            <label for="sname">Student Name</label>
                            <select name="sname" id="sname" class="form-control">
                              <option value="">Select Student</option>
                            </select>
                          </div>
                        </div>
                      </div>

                      <div class="" id="result"></div>

                      <div class="d-flex justify-content-end mt-3">
                        <button type="button" class="btn btn-primary btn-lg" id="formSubmit">
                          <i class="fa fa-save mr-1"></i> Submit Result
                        </button>
                      </div>
                    </form>
                </div>
              </div>

            </div>
        </section>
    </div>

    <script src="/public/lib/jquery/jquery.min.js"></script>
    <script src="/public/lib/bootstrap/js/bootstrap.min.js"></script>
    <script src="/public/lib/dropzone-5.7.0/dist/dropzone.js"></script>
    <script src="/public/js/admin.js"></script>
    <script src="/public/js/ajax.js"></script>
    <script>
      $(document).ready(() => {
        // Init Choices.js for single class selects
        window.sclassChoices = new Choices('#sclass', {
          searchEnabled: false,
          itemSelectText: '',
          shouldSort: false
        });

        new Choices('#select_class', {
          searchEnabled: false,
          itemSelectText: '',
          shouldSort: false
        });

        window.snameChoices = new Choices('#sname', {
          searchEnabled: true,
          itemSelectText: '',
          shouldSort: false
        });

        $("select, input").on('focus', () => {
          if ($('#err').css('display') != "none") $('#err').hide();
          if ($('.flash').css('display') != "none") $('.alert').hide();
        });

        $('#formSubmit').on('click', function () {
          const sclass = document.querySelector('#sclass').value;
          const student = document.querySelector('#sname').value;
          const flash = $('.flash');

          const caInputs = Array.from(document.querySelectorAll('input[id$="_ca"]'));
          const examInputs = Array.from(document.querySelectorAll('input[id$="_exam"]'));

          const caById = new Map(caInputs.map(i => [i.id.replace(/_ca$/, ''), i.value.trim()]));
          const examById = new Map(examInputs.map(i => [i.id.replace(/_exam$/, ''), i.value.trim()]));

          const globalSession = document.querySelector('#global_session').value;
          const globalTerm = document.querySelector('#global_term').value;

          const results = [];
          for (const subjectComboId of new Set([...caById.keys(), ...examById.keys()])) {
            const caStr = caById.get(subjectComboId);
            const examStr = examById.get(subjectComboId);

            if (caStr === '' || caStr === undefined || examStr === '' || examStr === undefined) {
                $('#err').text("Please enter a valid score (or '0') for all CA and Exam fields, or click the trash icon to remove the subject if not needed.").show();
                return;
            }

            const ca = Number(caStr);
            const exam = Number(examStr);

            if (isNaN(ca) || isNaN(exam) || ca < 0 || exam < 0) {
                $('#err').text("Scores must be valid non-negative numbers.").show();
                return;
            }

            results.push({
              subject: subjectComboId,
              ca_score: ca,
              exam_score: exam,
              session: globalSession,
              term: globalTerm,
              isRetake: false,
              student: student,
              sclass: sclass,
            });
          }

          if (!sclass || !student) {
              $('#err').text("Please select a class and a student.").show();
              return;
          }

          if (results.length === 0) {
              $('#err').text("No subjects found to declare results for.").show();
              return;
          }

          $.post('/admin/add-result', { type: "json", results }, (data) => {
            const successMessage = `Result uploaded successfully`;
            if (data.status == 404) {
              flash.css({ display: 'flex' }).removeClass('alert-success').addClass('alert-danger');
              $('#message').html(data.message);
            } else {
              flash.css({ display: 'flex' }).removeClass('alert-danger').addClass('alert-success p-3');
              $('#message').html(successMessage);

              // Clear the form
              if (window.sclassChoices) window.sclassChoices.setChoiceByValue("");
              if (window.snameChoices) window.snameChoices.setChoiceByValue("");
              $('#result').empty(); // Clear generated subject inputs
            }
          });
        });

        $('#download_template').click(() => {
          const classId = $('#select_class').val();
          fetch(`/admin/results/template/${classId}`)
            .then(response => {
              if (!response.ok) throw new Error("Network response was not ok");
              return response.blob();
            })
            .then(blob => {
              const url = window.URL.createObjectURL(blob);
              const a = document.createElement('a');
              a.style.display = 'none';
              a.href = url;
              a.download = 'results_template.xlsx';
              document.body.appendChild(a);
              a.click();
              window.URL.revokeObjectURL(url);
              document.body.removeChild(a);
            })
            .catch(error => {
              console.error('Error downloading template:', error);
              alert('Failed to download template. Please try again.');
            });
        });

        Dropzone.options.uploadWidget = {
          maxFiles: 1,
          dictDefaultMessage: 'Drop your .xlsx file here or click to upload',
          acceptedFiles: 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet',
          init: function () {
            this.on("success", function (file, responseText) {
              this.removeFile(file);
              $('#feedback').removeAttr('id');
              console.log(responseText);
            });
          }
        };
      });
    </script>
  </body>

  </html>