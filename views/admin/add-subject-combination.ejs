<!DOCTYPE html>
<html lang="en">

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/choices.js/public/assets/styles/choices.min.css">
<script src="https://cdn.jsdelivr.net/npm/choices.js/public/assets/scripts/choices.min.js"></script>

<%- include('partials/head') %>

<body>
<div class="container-fluid">
    <%- include('partials/header') %>
    <section class="row">
        <%- include('partials/nav') %>
        <div class="content offset-lg-3 col-lg-9 col-md-12 p-0 ">
            <div class="w-100 p-2 bg-white mt-2 mb-2">
                <h3 class=" modal-header">Class Subject Combination</h3>
                <div class="breadcrumb bg-transparent p-0">
                    <div class="breadcrumb-item">Home</div>
                    <div class="breadcrumb-item">Subject</div>
                    <div class="breadcrumb-item">Subject Combination</div>
                </div>
            </div>


            <div class="d-flex justify-content-center border">
                <div class="col-8 bg-white card">
                    <h4 class="p-3">Add Class Subject</h4>

                    <%- include('partials/flash') %>
                    <h4 id="err">Fill the corresponding value below</h4>

                    <form id="form-cb" action="" method="POST" class="">

                        <div class="form-group">
                            <label for="sclass_cb">Class Name</label>
                            <select name="class" id="sclass_cb" class="form-control">
                                <option value="">Select class</option>
                                <% classes.forEach(element=> { %>
                                    <option value="<%= element._id  %>" class="rmd">
                                        <%= element.cname %>
                                    </option>
                                <% }) %>
                            </select>
<!--                            <small><i>Eg. Grade 1, Grade 2, Grade 3</i></small>-->
                        </div>

                        <div class="form-group">
                            <label for="subjects">Class Name</label>
                            <select multiple name="subjects" id="subjects" class="form-control">
                                <option value="">Select class</option>
                                <% subjects.forEach(element=> { %>
                                    <option value="<%= element._id %>" class="rmd">
                                        <%= element.sname %>
                                    </option>
                                <% }) %>
                            </select>
<!--                            <small><i>Eg. Grade 1, Grade 2, Grade 3</i></small>-->
                        </div>

                        <button type="submit" class="btn btn-success mb-3 float-right">
                            Submit
                            <i class="fa fa-check"></i>
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </section>
</div>

<script src="../../public/lib/jquery//jquery.min.js "></script>
<script src="../../public/lib/bootstrap/js/bootstrap.min.js "></script>
<script src="../../public/js/admin.js"></script>
<script src="../../public/js/ajax.js"></script>


<script>
    $(document).ready(() => {
        $('#form-cb').on('submit', function(e) {
            console.log('submit')
            e.preventDefault()
            let classId = $('#sclass_cb').val(),
                subjects = $('#subjects').select().val(),
                err = $('#err'),
                message = $('#message'),
                alert = $('.alert'),
                flash = $('.flash');

            console.log(classId, subjects)

            if (!classId || subjects.length == 0 ) {
                err.css({
                    display: "block",
                })
            } else {
                $.post('/admin/subject-combination', {
                    class: classId,
                    subjects,
                }, (data) => {
                    data.type != "danger" ?
                        flash.removeClass("alert-danger").addClass("alert-success").show(1000)  && message.text(data.message) :
                        flash.removeClass("alert-sucess").addClass("alert-danger").show(1000) && message.text(data.message)
                    $('#classId').val("")
                    $('#subjects').val("")
                })
            }

        })

        $('select, input').on('focus', () => {
            if ($('#err').css('display') != "none" || $('.alert').css('display') != "none") {
                $('#err').hide()
                $('.alert').hide()
            }
        })
    })
</script>
</body>

<script>

    let choicesInstance

    choicesInstance = new Choices('#subjects', {
        removeItemButton: true,
        searchEnabled: true
    });
    choicesInstance.init();
    // new Choices('#subjects', {
    //     removeItemButton: true,
    //     searchEnabled: true
    // });
</script>

</html>