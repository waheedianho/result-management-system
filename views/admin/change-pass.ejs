<%- include('partials/head') %>

<body>
<div id="preloader"><div class="preloader-spinner"></div></div>
<div class="container-fluid p-0">
  <%- include('partials/header') %>
  <section class="d-flex">
    <%- include('partials/nav') %>
    <div class="content rms-content flex-grow-1">

      <!-- Page Header -->
      <div class="rms-page-header">
        <h3><i class="fa fa-lock mr-2" style="color:var(--primary)"></i>Change Password</h3>
        <ol class="breadcrumb mb-0">
          <li class="breadcrumb-item">Home</li>
          <li class="breadcrumb-item">Account</li>
          <li class="breadcrumb-item active">Change Password</li>
        </ol>
      </div>

      <!-- Form Card -->
      <div class="card" style="max-width:520px;">
        <div class="card-header">
          <h5 class="m-0" style="font-size:14px;"><i class="fa fa-key mr-2" style="color:var(--primary)"></i>Update Your Password</h5>
        </div>
        <div class="card-body">
          <%- include('partials/flash') %>
          <h4 id="err" style="display:none;font-size:14px;color:#ef4444;margin-bottom:12px;">Please fill in all fields below.</h4>

          <form action="/admin/change-password" method="POST">
            <div class="form-group">
              <label for="oldPass">Current Password</label>
              <input type="password" name="oldPass" id="oldPass" class="form-control" placeholder="Enter current password">
            </div>
            <div class="form-group">
              <label for="newPass">New Password</label>
              <input type="password" name="newPass" id="newPass" class="form-control" placeholder="Enter new password">
            </div>
            <div class="form-group mb-4">
              <label for="confirmPass">Confirm New Password</label>
              <input type="password" name="confirmPass" id="confirmPass" class="form-control" placeholder="Repeat new password">
            </div>
            <button type="submit" class="btn btn-primary">
              <i class="fa fa-save mr-1"></i> Update Password
            </button>
          </form>
        </div>
      </div>

    </div>
  </section>
</div>

<script src="/public/lib/jquery//jquery.min.js"></script>
<script src="/public/lib/bootstrap/js/bootstrap.min.js"></script>
<script src="/public/js/admin.js"></script>
</body>
</html>