<%- include('partials/head') %>
<script src="/public/lib/jquery//jquery.min.js "></script>

    <body>
        <div class="container-fluid">
            <%- include('partials/header') %>
                <section class="row">
                    <%- include('partials/nav') %>
                        <div class="content offset-lg-3 col-lg-9 col-md-12 p-0 ">
                            <div class="w-100 p-2 bg-white mt-2 mb-2">
                                <h3 class=" modal-header">Manage Student</h3>
                                <div class="breadcrumb bg-transparent p-0">
                                    <div class="breadcrumb-item">Home</div>
                                    <div class="breadcrumb-item">Subject</div>
                                    <div class="breadcrumb-item">Manage-Students</div>
                                </div>
                            </div>

                            <!-- Modal -->
                            <%- include('../modal/comfirmdelete') %>
                            <!-- Modal -->
                            <%- include('../modal/prompt') %>

                                <div class="container-fluid">
                                    <div class="row">
                                        <div class="col-12">
                                            <div class="card">
                                                <div class="card-header d-flex justify-content-between">
                                                    <h4 class="p-3">View Student Info</h4>
                                                     <div class="col-4 text-right">
                                                         <select class="form-control" name="sclass" id="filter">
                                                             <option value="">All</option>
                                                             <% classes.forEach(cls => { %>
                                                                <option value="<%= cls._id %>" ><%= cls.cname %></option>
                                                                 <script>
                                                                     $(document).ready(function () {
                                                                         // Get sclass from URL
                                                                         const params = new URLSearchParams(window.location.search);
                                                                         const selectedClass = params.get('sclass');
                                                                         console.log(selectedClass);
                                                             
                                                                         // Set selected option if sclass exists
                                                                         if(selectedClass) {
                                                                           $('#filter').val(selectedClass);
                                                                         }
                                                                    });
                                                             </script>

                                                             <%})%>
                                                         </select>
                                                    <button class="btn btn-primary mt-2" id="generate-result">Generate Result</button>
                                                     </div>
                                                </div>

                                                <div class=" card-body" id="overflow">
                                                    <table class="table table-bordered table-striped tdata">
                                                        <thead>
                                                            <th>#</th>
                                                            <th>Roll ID</th>
                                                            <th>Student Name</th>
                                                            <th>No of Result Upload</th>
                                                            <th>Date Modifield</th>
                                                            <th>Action</th>
                                                        </thead>
                                                        <tbody>
                                                            <% if (students.length !=0) { %>

                                                                <% students.forEach(student => { %>
                                                                    <tr>
                                                                        <td>
                                                                            <%= students.indexOf(student) + 1 %>
                                                                        </td>
                                                                        <td>
                                                                            <%= student.rollId %>
                                                                        </td>
                                                                        <td>
                                                                            <%= student.fname %>
                                                                        </td>
                                                                        <td>
                                                                            <%= student?.count %>
                                                                        </td>
                                                                        
                                                                        <td>
                                                                            <%= student.updatedAt.toLocaleString() %>
                                                                        </td>
                                                                        <td>
                                                                            <i class="btn btn-info fa fa-edit btn-delete btn-lg"
                                                                                data-target="#manage_result"
                                                                                data-toggle="modal"
                                                                                id="<%= student._id %>"></i>
                                                                        </td>
                                                                    </tr>
                                                                    <% }) %>

                                                                        <% } else{%>
                                                                            <p>You have not register any Class</p>
                                                                            <% } %>


                                                        </tbody>
                                                    </table>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>


                        </div>
                </section>
        </div>

        <script src="/public/lib/bootstrap/js/bootstrap.min.js "></script>
        <script src="/public/js/edit.js"></script>
        <script src="/public/js/ajaxDelete.js"></script>
        <script src="/public/js/admin.js"></script>

        <!-- datatable -->
        <script src="/public/lib/dt/datatables/jquery.dataTables.js"></script>
        <script src="/public/lib/dt/datatables-bs4/js/dataTables.bootstrap4.js"></script>
        <!-- <script src="/public/lib/dt/datatables-responsive/js/dataTables.responsive.js"></script> -->
        <script>
            const url = '<%= url %>'

            $(function () {
                $('.tdata').DataTable({
                    responsive: true,
                    // searching: false,
                    language: {
                        emptyTable: "No data available",
                        info: "Showing _START_ to _END_ of _TOTAL_ entries",
                        lengthMenu: "Show _MENU_ entries",
                    },
                    pageLength: 10,
                    lengthMenu: [[10, 25, 50, -1], [10, 25, 50, "All"]],
                    ordering: true,
                    processing: true
                })
            
                $('#prompt').DataTable({
                    paging: false,
                    searching: false,
                    ordering: false,
                    info: false,
                    responsive: true,
                })
            })
            // $(function () {
            //     $('.tdata').DataTable({
            //         responsive: true,
            //         // searching: false
            //     })
            //
            //     $('#prompt').DataTable({
            //         paging: false,
            //         searching: false,
            //         ordering: false,
            //         info: false,
            //         responsive: true,
            //     })
            // })


            $('#filter').on('change', function(){
                const classId = this.value;
                location.assign(`/admin/manage-result?sclass=${classId}`);
            })

            $('#generate-result').on('click', function(){
                const classId = document.getElementById('filter').value;
                if(!classId){
                    return alert('Please select a class to generate results');
                }
                window.open(`/admin/class-results?sclass=${classId}`, '_blank');
            })
        </script>
       
    </body>
