<%- include('partials/head') %>

<body>
  <div class="container-fluid">
    <%- include('partials/header') %>
    <section class="row">
      <%- include('partials/nav') %>
      <div class="content offset-lg-3 col-lg-9 col-md-12 p-0">
        <div class="w-100 p-2 bg-white mt-2 mb-2">
          <h3 class="modal-header">Manage Schools</h3>
          <div class="breadcrumb bg-transparent p-0">
            <div class="breadcrumb-item">Home</div>
            <div class="breadcrumb-item">Schools</div>
            <div class="breadcrumb-item">Manage-Schools</div>
          </div>
        </div>

        <div class="container-fluid">
          <div class="row mb-3">
            <div class="col-12 text-right">
              <button class="btn btn-primary" data-toggle="modal" data-target="#createSchoolModal">
                <i class="fa fa-plus"></i> Create New School
              </button>
            </div>
          </div>

          <!-- Modal for Create School -->
          <div class="modal fade" id="createSchoolModal" tabindex="-1" role="dialog" aria-hidden="true">
            <div class="modal-dialog" role="document">
              <div class="modal-content">
                <div class="modal-header">
                  <h5 class="modal-title">Create New School</h5>
                  <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                  </button>
                </div>
                <form id="createSchoolForm">
                  <div class="modal-body">
                    <div class="form-group">
                      <label>School Name</label>
                      <input type="text" name="name" class="form-control" required>
                    </div>
                    <div class="form-group">
                      <label>Address</label>
                      <input type="text" name="address" class="form-control">
                    </div>
                    <div class="form-group">
                      <label>Phone</label>
                      <input type="text" name="phone" class="form-control">
                    </div>
                    <div class="form-group">
                      <label>Email</label>
                      <input type="email" name="email" class="form-control">
                    </div>
                  </div>
                  <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
                    <button type="submit" class="btn btn-primary">Save School</button>
                  </div>
                </form>
              </div>
            </div>
          </div>

          <!-- Modal for Delete Confirmation -->
          <%- include('../modal/comfirmdelete') %>

          <div class="row">
            <div class="col-12">
              <div class="card">
                <div class="card-header">
                  <h4 class="m-0">Registered Schools</h4>
                </div>

                <div class="card-body" id="overflow">
                  <table class="table table-bordered table-striped" id="school_table">
                    <thead>
                      <th>#</th>
                      <th>Name</th>
                      <th>Address</th>
                      <th>Phone</th>
                      <th>Email</th>
                      <th>Action</th>
                    </thead>
                    <tbody id="school_tbody">
                      <% if (schools.length != 0) { %> <% schools.forEach(school => { %>
                      <tr>
                        <td><%= schools.indexOf(school) + 1 %></td>
                        <td>
                          <input type="text" name="name" value="<%= school.name %>" class="form-control bg-transparent border-0 unclick" disabled />
                        </td>
                        <td>
                          <input type="text" name="address" value="<%= school.address %>" class="form-control bg-transparent border-0 unclick" disabled />
                        </td>
                        <td>
                          <input type="text" name="phone" value="<%= school.phone %>" class="form-control bg-transparent border-0 unclick" disabled />
                        </td>
                        <td>
                          <input type="email" name="email" value="<%= school.email %>" class="form-control bg-transparent border-0 unclick" disabled />
                        </td>
                        <td class="text-center actionBtn">
                          <i class="btn btn-info fa fa-edit edit" id="<%= school._id %>"></i>
                          <i class="btn btn-danger fa fa-trash-o btn-delete" data-target="#delete" data-toggle="modal" id="<%= school._id %>"></i>
                        </td>
                      </tr>
                      <% }) %> <% } else{%>
                      <tr><td colspan="6" class="text-center text-muted">No schools found</td></tr>
                      <% } %>
                    </tbody>
                  </table>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
  </div>

  <script src="/public/lib/jquery//jquery.min.js "></script>
  <script src="/public/lib/bootstrap/js/bootstrap.min.js "></script>
  <script src="/public/js/admin.js"></script>

  <!-- datatable -->
  <script src="/public/lib/dt/datatables/jquery.dataTables.js"></script>
  <script src="/public/lib/dt/datatables-bs4/js/dataTables.bootstrap4.js"></script>
  
  <script>
    $(function () {
      const table = $('#school_table').DataTable({
        responsive: true,
      });

      // Create School
      $('#createSchoolForm').submit(function(e) {
        e.preventDefault();
        const data = $(this).serialize();
        $.post('/admin/schools', data, function(res) {
          location.reload();
        }).fail(function(err) {
          alert('Error creating school: ' + (err.responseJSON?.message || 'Unknown error'));
        });
      });

      // Edit School Toggle
      $(document).on('click', '.edit', function() {
        const row = $(this).closest('tr');
        const inputs = row.find('input');
        if ($(this).hasClass('fa-edit')) {
          inputs.prop('disabled', false).removeClass('border-0 unclick').addClass('bg-white');
          $(this).removeClass('fa-edit btn-info').addClass('fa-save btn-success');
        } else {
          const id = $(this).attr('id');
          const data = {};
          inputs.each(function() {
            data[$(this).attr('name')] = $(this).val();
          });
          $.ajax({
            url: '/admin/schools/' + id,
            method: 'PUT',
            data: data,
            success: function() {
              inputs.prop('disabled', true).addClass('border-0 unclick').removeClass('bg-white');
              $('.edit[id="'+id+'"]').removeClass('fa-save btn-success').addClass('fa-edit btn-info');
            }
          });
        }
      });

      // Delete School
      let deleteId = '';
      $(document).on('click', '.btn-delete', function() {
        deleteId = $(this).attr('id');
      });

      $('#comfirm_delete').click(function() {
        $.ajax({
          url: '/admin/schools/' + deleteId,
          method: 'DELETE',
          success: function() {
            location.reload();
          }
        });
      });
    });
  </script>
</body>