<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Page Not Found</title>
  <link rel="stylesheet" href="/public/lib/bootstrap/css/bootstrap.min.css">
  <link rel="stylesheet" href="/public/css/style.css">
  <style>
    body{background:#f8f9fa}
    .error-code{font-size:6rem; font-weight:700; color:#6c757d;}
    .error-card{max-width:720px}
  </style>
</head>
<body>
  <div class="container d-flex align-items-center justify-content-center min-vh-100">
    <div class="card shadow-sm error-card w-100">
      <div class="card-body text-center p-5">
        <div class="error-code">404</div>
        <h1 class="h3 mb-3">Page not found</h1>
        <p class="text-muted">The page you are looking for does not exist or may have been moved.</p>
        <p class="small text-muted">Requested URL: <code><%= typeof url !== 'undefined' ? url : (typeof originalUrl !== 'undefined' ? originalUrl : '') %></code></p>
        <div class="mt-4 d-flex gap-2 justify-content-center">
          <a class="btn btn-primary" href="/">Go to Home</a>
          <a class="btn btn-outline-secondary" href="javascript:history.back()">Go Back</a>
        </div>
      </div>
    </div>
  </div>
  <script src="/public/lib/jquery/jquery.min.js"></script>
  <script src="/public/lib/bootstrap/js/bootstrap.min.js"></script>
</body>
</html>
