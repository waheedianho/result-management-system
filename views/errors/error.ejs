<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= status || 500 %> Error</title>
  <link rel="stylesheet" href="/public/lib/bootstrap/css/bootstrap.min.css">
  <link rel="stylesheet" href="/public/css/style.css">
  <style>
    body{background:#fff}
    .error-code{font-size:5rem; font-weight:700; color:#dc3545;}
    .error-card{max-width:820px}
    pre{white-space:pre-wrap; word-break:break-word;}
  </style>
</head>
<body>
  <div class="container d-flex align-items-center justify-content-center min-vh-100">
    <div class="card shadow-sm error-card w-100">
      <div class="card-body p-5">
        <div class="text-center mb-4">
          <div class="error-code"><%= status || 500 %></div>
          <h1 class="h3 mb-2">Something went wrong</h1>
          <p class="text-muted">An unexpected error occurred while processing your request.</p>
        </div>
        <div class="mb-3">
          <strong>Message:</strong>
          <div class="text-monospace"><%= message || 'Internal Server Error' %></div>
        </div>
        <% if (stack) { %>
          <div class="mt-3">
            <strong>Stack trace (development only):</strong>
            <pre class="bg-light p-3 rounded border"><%= stack %></pre>
          </div>
        <% } %>
        <div class="mt-4 d-flex gap-2 justify-content-center">
          <a class="btn btn-primary" href="/">Go to Home</a>
          <a class="btn btn-outline-secondary" href="javascript:history.back()">Go Back</a>
        </div>
      </div>
    </div>
  </div>
  <script src="/public/lib/jquery/jquery.min.js"></script>
  <script src="/public/lib/bootstrap/js/bootstrap.min.js"></script>
</body>
</html>
