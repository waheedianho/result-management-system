<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Student Result Checker — Enter your Roll ID to view your results">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Outfit:wght@400;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="../public/lib/bootstrap/css/bootstrap.css">
  <link rel="stylesheet" href="../public/lib/font-awesome/css/font-awesome.min.css">
  <link rel="stylesheet" href="../public/css/theme.css">
  <title>Result Checker</title>
  <style>
    <% if (typeof branding !== 'undefined' && branding) { %>
    :root {
      --primary: <%= branding.primaryColor || '#6366f1' %>;
      --accent:  <%= branding.accentColor  || '#8b5cf6' %>;
    }
    <% } %>
  </style>
</head>

<body style="margin:0;padding:0;">

<div class="rms-checker-bg">
  <% const _b = (typeof branding !== 'undefined') ? branding : { schoolName: 'EduAdmin', logoUrl: null, tagline: '' }; %>
  <% const _i = _b.schoolName.split(' ').map(w=>w[0]).join('').toUpperCase().slice(0,2); %>

  <div class="rms-checker-card glass-card" style="padding:32px 28px;">

    <!-- Brand -->
    <div class="text-center mb-4">
      <% if (_b.logoUrl) { %>
        <img src="<%= _b.logoUrl %>" alt="<%= _b.schoolName %>" style="width:64px;height:64px;object-fit:contain;border-radius:12px;background:rgba(255,255,255,0.15);padding:6px;margin-bottom:12px;">
      <% } else { %>
        <div style="width:64px;height:64px;border-radius:12px;background:linear-gradient(135deg,var(--primary),var(--accent));display:flex;align-items:center;justify-content:center;color:#fff;font-size:24px;font-weight:800;font-family:'Outfit',sans-serif;margin:0 auto 12px;">
          <%= _i %>
        </div>
      <% } %>
      <h5 style="font-size:15px;margin:0 0 2px;"><%= _b.schoolName %></h5>
      <p style="color:var(--text-secondary);font-size:12.5px;margin:0;">Student Result Checker</p>
    </div>

    <!-- Error -->
    <% if (error) { %>
    <div class="alert alert-danger mb-3" role="alert" style="font-size:13px;">
      <i class="fa fa-exclamation-circle mr-2"></i><%= error?.msg %>
    </div>
    <% } %>

    <form action="/student/result" method="POST">
      <div class="form-group mb-3">
        <label for="rollId" style="color:var(--text-secondary)!important;">Roll ID</label>
        <div style="position:relative;">
          <i class="fa fa-id-card" style="position:absolute;left:12px;top:50%;transform:translateY(-50%);color:var(--text-muted);font-size:14px;"></i>
          <input type="text" required class="form-control" name="rollId" id="rollId" placeholder="Enter your Roll ID" style="padding-left:38px!important;">
        </div>
      </div>

      <div class="form-group mb-4">
        <label for="sclass" style="color:var(--text-secondary)!important;">Select Class</label>
        <select name="sclass" id="sclass" class="form-control">
          <option value="">— Select your class —</option>
          <% for (const cl of classes) { %>
            <option value="<%= cl._id %>"><%= cl.cname %></option>
          <% } %>
        </select>
      </div>

      <button type="submit" class="btn btn-primary w-100" style="padding:11px!important;font-size:14px!important;">
        <i class="fa fa-search mr-2"></i>Search Result
      </button>
    </form>

    <div class="text-center mt-4">
      <a href="/" style="color:var(--text-muted);font-size:12.5px;text-decoration:none;">
        <i class="fa fa-arrow-left mr-1"></i> Back to home
      </a>
    </div>
  </div>

  <!-- Dark mode toggle -->
  <button class="btn-theme-toggle" id="publicThemeToggle" style="position:fixed;top:16px;right:16px;background:rgba(255,255,255,0.2);border-color:rgba(255,255,255,0.3);color:#fff;">
    <i class="fa fa-moon-o" id="publicThemeIcon"></i>
  </button>
</div>

<script>
  (function() {
    const STORAGE_KEY = 'rms-theme';
    const btn = document.getElementById('publicThemeToggle');
    const icon = document.getElementById('publicThemeIcon');
    function applyTheme(t) {
      document.documentElement.setAttribute('data-theme', t);
      localStorage.setItem(STORAGE_KEY, t);
      if (icon) icon.className = t === 'dark' ? 'fa fa-sun-o' : 'fa fa-moon-o';
    }
    applyTheme(localStorage.getItem(STORAGE_KEY) || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light'));
    if (btn) btn.addEventListener('click', function() {
      applyTheme(document.documentElement.getAttribute('data-theme') === 'dark' ? 'light' : 'dark');
    });
  })();
</script>
</body>
</html>